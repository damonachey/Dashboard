# Copy the relevant vars into packages/backend/.env — never commit that file.

# GitHub personal access token (read:notifications, repo scope for private repo issues if needed)
GITHUB_TOKEN=

# Google OAuth client (type "Desktop app" in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect port used during the one-time OAuth consent flow
GOOGLE_OAUTH_REDIRECT_PORT=53682

# Backend HTTP port
PORT=4317

# Where the SQLite DB file lives (defaults to packages/backend/data if unset)
DATA_DIR=
